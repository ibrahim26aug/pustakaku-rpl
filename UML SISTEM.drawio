        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #DAE8FC\n  BorderColor #6C8EBF\n}\n\n&#39; 1. Aktor Kiri (Didefinisikan sebelum sistem)\nactor Pasien\nactor \&quot;Petugas Loket\&quot; as Petugas\n\n&#39; 2. Kotak Sistem &amp; Use Case\nrectangle \&quot;Sistem Antrean Poliklinik\&quot; {\n  usecase \&quot;Ambil Nomor\\nAntrean\&quot; as UC_Ambil\n  usecase \&quot;Pilih Poliklinik\&quot; as UC_Pilih\n  usecase \&quot;Daftar Pasien\\nBaru\&quot; as UC_DaftarBaru\n  usecase \&quot;Memanggil\\nNomor Antrean\&quot; as UC_Panggil\n  usecase \&quot;Memperbarui\\nStatus Antrean\&quot; as UC_Status\n  usecase \&quot;Melihat Laporan\\nHarian\&quot; as UC_Laporan\n\n  &#39; Relasi Antar Use Case di dalam sistem\n  UC_Ambil .&gt; UC_Pilih : &lt;&lt;include&gt;&gt;\n  UC_DaftarBaru .&gt; UC_Ambil : &lt;&lt;extend&gt;&gt;\n}\n\n&#39; 3. Aktor Kanan (Didefinisikan setelah sistem)\nactor Dokter\nactor \&quot;Admin / Kepala\&quot; as Admin\n\n&#39; 4. Hubungan Garis (Polos tanpa panah)\nPasien -- UC_Ambil\nPetugas -- UC_DaftarBaru\nPetugas -- UC_Panggil\n\nUC_Panggil -- Dokter\nUC_Status -- Dokter\nUC_Laporan -- Admin\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QP3km2HJRwIx8h-xL4qN-125">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
